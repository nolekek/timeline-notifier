# ==== Обязательное ====
# Ключ Flask (сессии/подпись). Сгенерировать: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-flask-secret
# Ключ шифрования паролей ЭИОС. НЕ МЕНЯТЬ после запуска — иначе пароли не расшифруются.
CRED_KEY=change-me-cred-key

FLASK_APP=run.py
FLASK_DEBUG=0

# ==== Telegram ====
# Bot Token задаётся в админке (http://сервер:5000/), здесь не нужен.
# Если api.telegram.org с сервера недоступен (РФ) — SOCKS5/HTTP прокси:
# TELEGRAM_PROXY=socks5h://127.0.0.1:1080
# Либо свой мирор/реверс-прокси Bot API:
# TELEGRAM_API_BASE=https://tg-api.example.com
# TELEGRAM_TIMEOUT=20
# TELEGRAM_POLL_TIMEOUT=25

# Твой chat_id: включает админ-команды бота /admin и /broadcast (узнать: @userinfobot)
ADMIN_CHAT_ID=

# ==== Админка (Basic Auth) ====
# ADMIN_PASSWORD пустой = админка без пароля (только для локальной отладки!)
ADMIN_USER=admin
ADMIN_PASSWORD=

# ==== Проверки ====
# Интервал проверки по умолчанию для новых пользователей, сек
DEFAULT_CHECK_INTERVAL=300
# Как часто планировщик смотрит, кому пора проверяться, сек
SCHEDULER_TICK=60
# Сколько логинов в Timeline делать одновременно
CHECK_WORKERS=4
# Не логиниться в Timeline чаще, чем раз в N секунд на человека (защита от кнопкотыканья)
MIN_CHECK_GAP=60
# Повторы входа при обрывах связи с сайтом (ConnectionReset/таймаут)
LOGIN_ATTEMPTS=3
LOGIN_RETRY_DELAY=2

# ==== Веб ====
WEB_HOST=0.0.0.0
WEB_PORT=5000
# Прод-сервер вместо Flask dev: USE_WAITRESS=1 (нужен pip install waitress)
# USE_WAITRESS=0

# ==== Docker (нужно только для docker compose) ====
# uid/gid, от которого работает контейнер: должен совпадать с владельцем папки ./instance,
# тогда база пишется без sudo и бэкап = обычное копирование файла.
# Проверить: id -u и id -g (у первого пользователя Ubuntu обычно 1000).
# APP_UID=1000
# APP_GID=1000

# ==== Timeline (менять только если сайт переехал) ====
# TIMELINE_BASE_URL=https://timeline.rsvpu.ru
# TIMELINE_LOGIN_URL=https://eios.rsvpu.ru/Account/Login
# TIMELINE_WORKS_URL=https://timeline.rsvpu.ru/StudentWork/Send
# TIMELINE_GRID_URL=https://timeline.rsvpu.ru/StudentWork/SendGrid
# Проверка сертификата сайта. По умолчанию ВКЛЮЧЕНА (сертификаты валидные) —
# по этому соединению ходят логин/пароль студентов. Отключай только если
# точно знаешь, что делаешь:
# TIMELINE_VERIFY_SSL=true
# Сохранять сырые HTML/JSON в instance/debug для починки парсера:
# TIMELINE_DEBUG_DUMP=false

# ==== База ====
# DATABASE_URL=sqlite:///instance/timeline.db
