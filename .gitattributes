# Нормализация переводов строк: код для Linux/Docker — LF, windows-скрипт — CRLF.
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
*.bat text eol=crlf
